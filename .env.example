# Copy this file to .env and fill in real values for your environment.
# main.py reads these via os.environ.get() -- if you use docker-compose
# (see docker-compose.yml), it loads this file automatically.

# --- Domain / HTTPS ------------------------------------------------------
# Real domain name pointing at this server's public IP (an A record you've
# already created), e.g. api.guidyapp.com. Caddy (see Caddyfile and the
# "caddy" service in docker-compose.yml) uses this to request and renew a
# Let's Encrypt certificate automatically -- no manual cert steps needed.
# Must be a real, publicly resolvable domain; Caddy cannot get a cert for
# a bare IP or a LAN address.
DOMAIN=api.example.com

# --- GTFS data ---------------------------------------------------------
# Absolute path to the folder containing stops.txt, routes.txt, trips.txt,
# and stop_times.txt. Required -- the backend won't start without it.
GTFS_PATH=/data/gtfs

# --- OSRM (real walking directions) -------------------------------------
# Set to "false" to disable OSRM entirely and fall back to straight-line
# haversine walking estimates (e.g. if you haven't set up OSRM yet).
USE_OSRM=true
# Base URL of your self-hosted OSRM instance. See osrm_client.py for the
# full setup steps (Docker-based, using the Egypt Geofabrik extract).
# If running via docker-compose.yml alongside this backend, use the
# service name below instead of localhost.
OSRM_BASE_URL=http://osrm:5000

# --- CORS ----------------------------------------------------------------
# Comma-separated list of allowed origins. "*" is fine while this only
# serves the Flutter mobile app (which isn't subject to CORS). Restrict
# this to your actual domain(s) if you ever add a web client.
CORS_ALLOWED_ORIGINS=*

# --- Logging ---------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Rate limiting ---------------------------------------------------
# Requests per minute allowed per client IP on /api/route. See main.py.
RATE_LIMIT_PER_MINUTE=30
